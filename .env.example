# ==============================================================================
# E-INVORA settings. Copy this file to ".env" (start-local.bat does it for you).
# Never share or commit your real .env file.
# ==============================================================================

# Port for the website (if busy, the next free port is used and shown in the terminal)
PORT=3000

# --- Owner (admin) login -------------------------------------------------------
# Option A (recommended): leave these blank. Open /admin/login, enter the one-time
#   setup key printed in the terminal, and choose your own email + password there.
# Option B: set a setup key of your own (16+ characters) for first-time setup:
#   OWNER_SETUP_KEY=
# Option C: create the owner from this file on first start (12+ char password).
#   The password is stored only as a hash; remove it from this file afterwards.
#   ADMIN_EMAIL=
#   ADMIN_PASSWORD=

# Long random text used to sign admin sessions. Optional locally, REQUIRED in production.
# Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ADMIN_SECRET_SESSION=

# --- Optional: AI drafting (server side only) -----------------------------------
#   GEMINI_API_KEY=

# --- Business contact details (used as defaults; editable in Admin > Settings) ----
# WhatsApp +91 8778095016 | Phone +91 8778095016 | Email nivasrhari@gmail.com
